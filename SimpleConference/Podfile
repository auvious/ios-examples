# Uncomment the next line to define a global platform for your project
platform :ios, '15.0'

source 'https://github.com/auvious/CocoaPodSpecs.git'
source 'https://cdn.cocoapods.org/'

target 'SimpleConference' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!

  # Pods for SimpleConference
  pod 'AuviousSDK', '1.5.0'

end

# Xcode 27 refuses deployment targets below iOS 15, and some dependencies still declare lower ones
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
